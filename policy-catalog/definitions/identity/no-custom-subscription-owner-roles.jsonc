{
    "name": "sp-no-custom-subscription-owner-roles",
    "type": "Microsoft.Authorization/policyDefinitions",
    "properties": {
        "displayName": "Audit custom RBAC roles with wildcard owner permissions",
        "description": "Audits custom role definitions that include a wildcard (*) action, which grants owner-equivalent permissions. Use built-in roles or narrowly scoped custom roles instead.",
        "mode": "All",
        "metadata": {
            "version": "1.0.0",
            "category": "Identity",
            "pacMetadata": {
                "industry": [ "all" ],
                "frameworks": [ "cis-azure-2.0", "pci-dss-4.0", "hipaa" ],
                "severity": "high",
                "references": [
                    "https://www.cisecurity.org/benchmark/azure",
                    "https://learn.microsoft.com/azure/role-based-access-control/best-practices"
                ]
            }
        },
        "parameters": {
            "effect": {
                "type": "String",
                "metadata": { "displayName": "Effect" },
                "allowedValues": [ "Audit", "Disabled" ],
                "defaultValue": "Audit"
            }
        },
        "policyRule": {
            "if": {
                "allOf": [
                    {
                        "field": "type",
                        "equals": "Microsoft.Authorization/roleDefinitions"
                    },
                    {
                        "field": "Microsoft.Authorization/roleDefinitions/type",
                        "equals": "CustomRole"
                    },
                    {
                        "field": "Microsoft.Authorization/roleDefinitions/permissions[*].actions[*]",
                        "equals": "*"
                    }
                ]
            },
            "then": {
                "effect": "[parameters('effect')]"
            }
        }
    }
}
