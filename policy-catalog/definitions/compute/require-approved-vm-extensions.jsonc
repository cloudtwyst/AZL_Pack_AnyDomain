{
    "name": "sp-require-approved-vm-extensions",
    "type": "Microsoft.Authorization/policyDefinitions",
    "properties": {
        "displayName": "Audit VM extensions not in the approved list",
        "description": "Virtual machine extensions that are not on the approved list may indicate malicious activity or policy drift. Audit extensions to ensure only approved tooling is installed.",
        "mode": "Indexed",
        "metadata": {
            "version": "1.0.0",
            "category": "Compute",
            "pacMetadata": {
                "industry": [ "all" ],
                "frameworks": [ "cis-azure-2.0", "nist-800-53" ],
                "severity": "medium",
                "references": [
                    "https://learn.microsoft.com/azure/virtual-machines/extensions/overview",
                    "https://www.cisecurity.org/benchmark/azure"
                ]
            }
        },
        "parameters": {
            "effect": {
                "type": "String",
                "metadata": { "displayName": "Effect" },
                "allowedValues": [ "Audit", "Disabled" ],
                "defaultValue": "Audit"
            },
            "approvedExtensions": {
                "type": "Array",
                "metadata": {
                    "displayName": "Approved VM extension types",
                    "description": "List of approved extension type names. Extensions not in this list will be flagged."
                },
                "defaultValue": [
                    "MicrosoftMonitoringAgent",
                    "AzureMonitorWindowsAgent",
                    "AzureMonitorLinuxAgent",
                    "MicrosoftDefenderForEndpoint",
                    "CustomScriptExtension",
                    "AADSSHLoginForLinux",
                    "AADLoginForWindows"
                ]
            }
        },
        "policyRule": {
            "if": {
                "allOf": [
                    { "field": "type", "equals": "Microsoft.Compute/virtualMachines/extensions" },
                    { "field": "Microsoft.Compute/virtualMachines/extensions/type", "notIn": "[parameters('approvedExtensions')]" }
                ]
            },
            "then": {
                "effect": "[parameters('effect')]"
            }
        }
    }
}
