{
    "name": "sp-require-vm-backup",
    "type": "Microsoft.Authorization/policyDefinitions",
    "properties": {
        "displayName": "Audit virtual machines without Azure Backup configured",
        "description": "Virtual machines should be protected by Azure Backup. Checks that a backup item exists in a Recovery Services vault for each in-scope VM.",
        "mode": "Indexed",
        "metadata": {
            "version": "1.0.0",
            "category": "Backup",
            "pacMetadata": {
                "industry": [ "all" ],
                "frameworks": [ "iso-27001", "hipaa" ],
                "severity": "high",
                "references": [
                    "https://learn.microsoft.com/azure/backup/backup-azure-vms-introduction",
                    "https://www.iso.org/standard/54534.html"
                ]
            }
        },
        "parameters": {
            "effect": {
                "type": "String",
                "metadata": { "displayName": "Effect" },
                "allowedValues": [ "AuditIfNotExists", "Disabled" ],
                "defaultValue": "AuditIfNotExists"
            }
        },
        "policyRule": {
            "if": {
                "field": "type",
                "equals": "Microsoft.Compute/virtualMachines"
            },
            "then": {
                "effect": "[parameters('effect')]",
                "details": {
                    "type": "Microsoft.RecoveryServices/backupprotecteditems",
                    "existenceCondition": {
                        "field": "name",
                        "exists": true
                    }
                }
            }
        }
    }
}
