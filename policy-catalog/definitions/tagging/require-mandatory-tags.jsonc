{
    "name": "sp-require-mandatory-tags",
    "type": "Microsoft.Authorization/policyDefinitions",
    "properties": {
        "displayName": "Require mandatory tags on resource groups",
        "description": "Audits or denies resource groups that are missing any of the mandatory tags: Environment, Owner, CostCenter.",
        "mode": "Indexed",
        "metadata": {
            "version": "1.0.0",
            "category": "Tags",
            "pacMetadata": {
                "industry": [ "all" ],
                "frameworks": [ "azure-security-benchmark" ],
                "severity": "low",
                "references": [
                    "https://learn.microsoft.com/security/benchmark/azure/security-controls-v3-governance-strategy#gs-1-define-asset-management-and-data-protection-strategy"
                ]
            }
        },
        "parameters": {
            "effect": {
                "type": "String",
                "metadata": { "displayName": "Effect" },
                "allowedValues": [ "Audit", "Deny", "Disabled" ],
                "defaultValue": "Audit"
            }
        },
        "policyRule": {
            "if": {
                "allOf": [
                    { "field": "type", "equals": "Microsoft.Resources/subscriptions/resourceGroups" },
                    {
                        "anyOf": [
                            { "field": "tags['Environment']", "exists": false },
                            { "field": "tags['Owner']", "exists": false },
                            { "field": "tags['CostCenter']", "exists": false }
                        ]
                    }
                ]
            },
            "then": {
                "effect": "[parameters('effect')]"
            }
        }
    }
}
