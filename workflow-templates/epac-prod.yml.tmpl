# Rendered by solpack from workflow-templates/epac-prod.yml.tmpl
# Re-run 'solpack render' to regenerate from customer-config.yaml.
name: EPAC — Prod plan + deploy

on:
  push:
    branches: [main]
    paths:
      - "Definitions/**"
  workflow_dispatch:

permissions:
  id-token: write
  contents: read

jobs:
  build-plan:
    name: Build deployment plans (epac-prod)
    runs-on: ubuntu-latest
    environment: epac-prod

    steps:
      - uses: actions/checkout@v4

      - name: Azure login (OIDC)
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.EPAC_BUILD_CLIENT_ID }}
          tenant-id: {{TENANT_ID}}
          subscription-id: ${{ secrets.MGMT_SUBSCRIPTION_ID }}

      - name: Install EPAC
        shell: pwsh
        run: Install-Module EnterprisePolicyAsCode -Force -Scope CurrentUser

      - name: Build deployment plans
        shell: pwsh
        run: |
          Build-DeploymentPlans.ps1 `
            -PacEnvironmentSelector epac-prod `
            -DefinitionsRootFolder ./Definitions `
            -OutputFolder ./Output

      - name: Upload plan artifact
        uses: actions/upload-artifact@v4
        with:
          name: epac-prod-plan
          path: Output/
          retention-days: 7

  deploy:
    name: Deploy to epac-prod
    runs-on: ubuntu-latest
    needs: build-plan
    # Required reviewers gate lives on the epac-prod GitHub Environment.
    environment: epac-prod

    steps:
      - uses: actions/checkout@v4

      - name: Download plan artifact
        uses: actions/download-artifact@v4
        with:
          name: epac-prod-plan
          path: Output/

      - name: Azure login (OIDC)
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.EPAC_DEPLOY_CLIENT_ID }}
          tenant-id: {{TENANT_ID}}
          subscription-id: ${{ secrets.MGMT_SUBSCRIPTION_ID }}

      - name: Install EPAC
        shell: pwsh
        run: Install-Module EnterprisePolicyAsCode -Force -Scope CurrentUser

      - name: Deploy policy plan
        shell: pwsh
        run: Deploy-PolicyPlan.ps1 -PacEnvironmentSelector epac-prod -InputFolder ./Output

      - name: Deploy roles plan
        shell: pwsh
        run: Deploy-RolesPlan.ps1 -PacEnvironmentSelector epac-prod -InputFolder ./Output
